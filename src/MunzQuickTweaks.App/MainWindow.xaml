<Window x:Class="MunzQuickTweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MunzQuickTweaks.App.ViewModels"
        xmlns:views="clr-namespace:MunzQuickTweaks.App.Views"
        xmlns:c="clr-namespace:MunzQuickTweaks.App.Controls"
        Title="Munz Quick Tweaks"
        Width="1100" Height="720" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource FontSans}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Eigene Titelleiste, Ränder bleiben zum Ziehen und Größe ändern nutzbar -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Zuordnung ViewModel zu Seite -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
            <views:TweaksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}">
            <views:AppsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessRulesViewModel}">
            <views:ProcessRulesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PowerViewModel}">
            <views:PowerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallerViewModel}">
            <views:InstallerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
            <views:NetworkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HealthViewModel}">
            <views:HealthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PresetsViewModel}">
            <views:PresetsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}">
            <views:BenchmarkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiskViewModel}">
            <views:DiskView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <views:DriversView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameModeViewModel}">
            <views:GameModeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebloatViewModel}">
            <views:DebloatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <views:StartupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CareViewModel}">
            <views:CareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestoreViewModel}">
            <views:RestoreView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>

        <!-- Navigation nach Gruppen -->
        <CollectionViewSource x:Key="NavGroups" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupKey" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <!-- Munz: Pixel-Icon, Liquid Glass: Symbol aus der Windows-Symbolschrift -->
                    <c:PixelIcon Pattern="{Binding IconPattern}" Width="14" Height="14" Margin="0,0,12,0" Visibility="{x:Static c:UiDesign.MunzVisibility}" />
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="16" Margin="0,0,12,0"
                               VerticalAlignment="Center" TextAlignment="Center" Visibility="{x:Static c:UiDesign.LiquidGlassVisibility}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Seitenleiste -->
            <!-- Apple-Variante: Seitenleiste als Material. Unter Windows 11 scheint das Mica-Glas durch, unter Windows 10 fest -->
            <Border x:Name="SidebarBg" Grid.RowSpan="2" Background="{StaticResource Bg2}" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" />
            <Border x:Name="ContentBg" Grid.Column="1" Grid.RowSpan="2" Background="{StaticResource Bg}" />

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <c:PixelLogo x:Name="SideLogo" Width="22" Height="22" />
                <TextBlock Text="{DynamicResource App.Name}" Style="{StaticResource TextBase}" FontFamily="{StaticResource FontDisplay}"
                           FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>

            <!-- Seitenleiste: Gruppen scrollen bei kleinem Fenster, Markierung gleitet mit -->
            <DockPanel Grid.Row="1" Grid.Column="0" Margin="12,6,12,14">
                <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource App.By}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="12,10,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" c:SmoothScroll.IsEnabled="True">
                    <Grid>
                        <!-- Gleitende Auswahl: Hintergrund und blaues Pixel wandern zum gewählten Eintrag -->
                        <Canvas x:Name="NavOverlay" IsHitTestVisible="False" ClipToBounds="False">
                            <Border x:Name="NavPill" CornerRadius="8" Background="{StaticResource NavPillBrush}" Width="{Binding ActualWidth, ElementName=NavOverlay}" Height="40" Opacity="0" />
                            <Rectangle x:Name="NavMarker" Width="4" Height="4" Fill="{StaticResource Blue}" Canvas.Left="4" Opacity="0" Visibility="{x:Static c:UiDesign.MunzVisibility}" />
                        </Canvas>
                        <ItemsControl x:Name="NavList" ItemsSource="{Binding Source={StaticResource NavGroups}}" ItemTemplate="{StaticResource NavItemTemplate}" Focusable="False">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Items[0].GroupTitle}" FontSize="11" Margin="12,14,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Items[0].GroupTitle}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </DockPanel>


            <!-- Inhalt -->
            <ScrollViewer x:Name="ContentScroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" c:SmoothScroll.IsEnabled="True">
                <Grid Margin="{StaticResource ContentMargin}" MaxWidth="980" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,24">
                        <!-- Update-Leiste: neue Version auf munz-its.de gemeldet -->
                        <Border Background="{StaticResource BlueSoft}" BorderBrush="{StaticResource Blue}" BorderThickness="1" CornerRadius="10"
                                Padding="16,10" Margin="0,8,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="14,7" FontSize="13" Content="{DynamicResource Update.Download}" Command="{Binding OpenUpdateCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="13" Content="{DynamicResource RestartBar.Later}" Command="{Binding DismissUpdateCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateText}" Style="{StaticResource TextBase}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <!-- Neustart-Leiste: erscheint, wenn Tweaks erst nach Explorer-Neustart, Abmelden oder Neustart wirken -->
                        <Border Background="{StaticResource BlueSoft}" BorderBrush="{StaticResource Blue}" BorderThickness="1" CornerRadius="10"
                                Padding="16,10" Margin="0,8,0,18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingRestart}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="14,7" FontSize="13" Content="{Binding RestartActionText}" Command="{Binding RunRestartActionCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="13" Content="{DynamicResource RestartBar.Later}" Command="{Binding DismissRestartCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding RestartText}" Style="{StaticResource TextBase}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <!-- Liquid Glass zeigt nur den großen Titel, Munz zusätzlich die Zeile darüber -->
                        <TextBlock Text="{Binding CurrentPage.Label}" Style="{StaticResource Label}" Margin="0,0,0,6" Visibility="{x:Static c:UiDesign.MunzVisibility}" />
                        <TextBlock Text="{Binding CurrentPage.Heading}" Style="{StaticResource Display}" />
                    </StackPanel>
                    <!-- Seiten werden einmal gebaut und danach wiederverwendet (MainWindow.ShowPage) -->
                    <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False">
                        <ContentControl.RenderTransform>
                            <TranslateTransform />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </ScrollViewer>


            <!-- Titelleiste rechts -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="{DynamicResource Caption.Minimize}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="{DynamicResource Caption.Maximize}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Rectangle Width="10" Height="10" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="{DynamicResource Caption.Close}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>

            <!-- Startbildschirm mit Logo-Aufbau, verschwindet nach maximal 1,5 Sekunden -->
            <Grid x:Name="Splash" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{StaticResource Bg}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <c:PixelLogo x:Name="SplashLogo" Width="112" Height="112" />
                    <TextBlock Text="{DynamicResource App.Name}" Style="{StaticResource Display}" FontSize="26"
                               HorizontalAlignment="Center" Margin="0,24,0,4" TextWrapping="NoWrap" />
                    <TextBlock Text="{DynamicResource App.By}" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
