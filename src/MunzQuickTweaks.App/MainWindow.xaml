<Window x:Class="MunzQuickTweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MunzQuickTweaks.App.ViewModels"
        xmlns:views="clr-namespace:MunzQuickTweaks.App.Views"
        xmlns:c="clr-namespace:MunzQuickTweaks.App.Controls"
        Title="Munz Quick Tweaks"
        Width="1100" Height="720" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource FontSans}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Eigene Titelleiste, Ränder bleiben zum Ziehen und Größe ändern nutzbar -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Zuordnung ViewModel zu Seite -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
            <views:TweaksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestoreViewModel}">
            <views:RestoreView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <c:PixelIcon Pattern="{Binding IconPattern}" Width="14" Height="14" Margin="0,0,12,0"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Seitenleiste -->
            <Border Grid.RowSpan="2" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" />

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <c:PixelLogo x:Name="SideLogo" Width="22" Height="22" />
                <TextBlock Text="{DynamicResource App.Name}" Style="{StaticResource TextBase}" FontFamily="{StaticResource FontDisplay}"
                           FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>

            <DockPanel Grid.Row="1" Grid.Column="0" Margin="12,14,12,14" LastChildFill="False">
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{StaticResource Line}" Margin="4,0,4,8" />
                    <ContentControl Content="{Binding SettingsItem}" ContentTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
                    <TextBlock Text="{DynamicResource App.By}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="12,10,0,0" />
                </StackPanel>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
            </DockPanel>

            <!-- Titelleiste rechts -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="{DynamicResource Caption.Minimize}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="{DynamicResource Caption.Maximize}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Rectangle Width="10" Height="10" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="{DynamicResource Caption.Close}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>

            <!-- Inhalt -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid Margin="40,8,40,40" MaxWidth="980" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource Display}" Margin="0,0,0,24" />
                    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
                </Grid>
            </ScrollViewer>

            <!-- Startbildschirm mit Logo-Aufbau, verschwindet nach maximal 1,5 Sekunden -->
            <Grid x:Name="Splash" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{StaticResource Bg}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <c:PixelLogo x:Name="SplashLogo" Width="112" Height="112" />
                    <TextBlock Text="{DynamicResource App.Name}" Style="{StaticResource Display}" FontSize="26"
                               HorizontalAlignment="Center" Margin="0,24,0,4" TextWrapping="NoWrap" />
                    <TextBlock Text="{DynamicResource App.By}" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
