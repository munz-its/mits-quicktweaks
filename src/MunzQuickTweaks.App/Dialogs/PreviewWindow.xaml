<Window x:Class="MunzQuickTweaks.App.Dialogs.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MunzQuickTweaks.App.Controls"
        Title="Munz Quick Tweaks" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Foreground="{StaticResource Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- Blatt über der abgedunkelten App: Klick auf den dunklen Bereich oder Esc bricht ab -->
    <Grid>
        <Rectangle x:Name="Scrim" Fill="#B3050609" Opacity="0" MouseLeftButtonDown="OnScrimClick" />
        <Border x:Name="Sheet" Width="620" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,36,0,36"
                Background="Transparent" CornerRadius="22" Opacity="0"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SheetMove" Y="-28" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="50" ShadowDepth="16" Direction="270" Opacity="0.5" Color="Black" />
            </Border.Effect>
        <!-- Liquid Glass: die App dahinter erscheint im Blatt gebrochen und weichgezeichnet -->
        <Grid>
        <c:GlassPanel x:Name="SheetGlass" CornerRadius="22" Blur="34" Refraction="20" Tint="#A6202126" />
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding Heading}" Style="{StaticResource H2}" FontSize="20" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Intro}" Style="{StaticResource Body2}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Background="{StaticResource Bg3}" Padding="18,14" Margin="0,0,8,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="15" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Title}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <CheckBox Style="{StaticResource PixelCheck}" Content="{Binding Text}" IsChecked="{Binding IsChecked}" />
                                                    <Border CornerRadius="4" Padding="6,0" Margin="8,0,0,0" Background="#1AFFB547" VerticalAlignment="Center"
                                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Badge}" Style="{StaticResource Label}" FontSize="10" Foreground="{StaticResource Warn}" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{Binding CancelText}" Margin="0,0,10,0" Click="OnCancel" />
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" IsDefault="True" Click="OnConfirm" />
            </StackPanel>
        </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
