<UserControl x:Class="MunzQuickTweaks.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

    </UserControl.Resources>

    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.Restore}" Style="{StaticResource Body2}" Margin="0,0,0,20" />

        <TextBlock Text="{Binding Status}" Margin="0,0,0,16">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                    <Setter Property="Foreground" Value="{StaticResource BlueXl}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Kacheln -->
        <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.ProtectionLabel}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding ProtectionText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                <Setter Property="FontSize" Value="20" />
                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProtectionOn}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Restore.PointsLabel}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding RestorePointCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource Text}" />
                    <TextBlock Text="{Binding LastPointText}" Style="{StaticResource Body2}" FontSize="13" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Restore.BackupsLabel}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding BackupCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource Text}" />
                    <TextBlock Text="{DynamicResource Restore.BackupsSub}" Style="{StaticResource Body2}" FontSize="13" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Systemschutz und Wiederherstellungspunkte -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Restore.Points}" Style="{StaticResource H2}" FontSize="16" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Rectangle Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill" Value="{StaticResource Warn}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProtectionOn}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Ok}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Restore.Enable}" VerticalAlignment="Top"
                            Command="{Binding EnableProtectionCommand}" Visibility="{Binding CanEnableProtection, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding RestorePoints}" Focusable="False" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Date}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource TextBase}" FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Restore.CreateNow}" Command="{Binding CreateRestorePointCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Restore.OpenWindows}" Command="{Binding OpenSystemRestoreCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Restore.OpenFolder}" Command="{Binding OpenBackupFolderCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Aktive Tweaks -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Restore.Active}" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{DynamicResource Restore.RevertAll}"
                            Command="{Binding RevertAllCommand}" Visibility="{Binding HasActiveTweaks, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <TextBlock Text="{DynamicResource Restore.NoActive}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveTweaks}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding ActiveTweaks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Since}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12"
                                            Content="{DynamicResource Restore.RevertOne}" Command="{Binding RevertCommand}" CommandParameter="{Binding Id}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Änderungsprotokoll -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Restore.History}" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="6" Height="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{StaticResource Ok}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
