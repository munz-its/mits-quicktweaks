<UserControl x:Class="MunzQuickTweaks.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.Drivers}" Style="{StaticResource Body2}" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Drivers.WindowsUpdate}" Command="{Binding OpenWindowsUpdateCommand}" Margin="0,0,10,0" />
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Drivers.Reload}" Command="{Binding LoadCommand}" />
        </StackPanel>

        <TextBlock Text="{DynamicResource Dashboard.Loading}" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource TextBase}" Foreground="{StaticResource Text2}" Margin="0,0,0,12" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Drivers}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Group}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border CornerRadius="4" Padding="7,1" Background="#1AFFB547" VerticalAlignment="Center"
                                            Visibility="{Binding IsOld, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Drivers.Old}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Warn}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding Device}" Style="{StaticResource TextBase}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0">
                                    <Run Text="{Binding Manufacturer, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Date, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" VerticalAlignment="Center"
                                    Content="{DynamicResource Drivers.Vendor}"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Link}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
