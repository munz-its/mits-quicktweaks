<UserControl x:Class="MunzQuickTweaks.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,24,14" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{DynamicResource Dashboard.Hello}" Style="{StaticResource H2}" Margin="0,0,0,6" />
        <TextBlock Text="{DynamicResource Dashboard.Intro}" Style="{StaticResource Body2}" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,24" />

        <!-- Hinweis bei nicht unterstützter Windows-Version -->
        <Border Background="#1AFFB547" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10"
                Padding="16,12" Margin="0,0,0,20"
                Visibility="{Binding IsUnsupported, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{DynamicResource Dashboard.Unsupported}" Style="{StaticResource TextBase}" Foreground="{StaticResource Warn}" />
        </Border>

        <!-- Profile: ein Klick für mehrere Tweaks -->
        <TextBlock Text="{DynamicResource Profile.Title}" Style="{StaticResource Label}" Margin="2,0,0,10" />
        <UniformGrid Columns="4" Margin="0,0,0,8">
            <UniformGrid.Resources>
                <Style x:Key="ProfileButton" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Margin" Value="0,0,12,0" />
                    <Setter Property="Command" Value="{Binding ApplyProfileCommand}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Blue}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </UniformGrid.Resources>
            <Button Style="{StaticResource ProfileButton}" CommandParameter="Recommended">
                <StackPanel>
                    <TextBlock Text="⭐" FontSize="18" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Profile.Recommended}" Style="{StaticResource TextBase}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Profile.Recommended.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ProfileButton}" CommandParameter="Gaming">
                <StackPanel>
                    <TextBlock Text="🎮" FontSize="18" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Profile.Gaming}" Style="{StaticResource TextBase}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Profile.Gaming.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ProfileButton}" CommandParameter="Privacy">
                <StackPanel>
                    <TextBlock Text="🔒" FontSize="18" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Profile.Privacy}" Style="{StaticResource TextBase}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Profile.Privacy.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ProfileButton}" CommandParameter="ResetAll" Margin="0">
                <StackPanel>
                    <TextBlock Text="↩️" FontSize="18" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Profile.ResetAll}" Style="{StaticResource TextBase}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Profile.ResetAll.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </Button>
        </UniformGrid>
        <TextBlock Text="{Binding ProfileStatus}" Margin="2,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                    <Setter Property="Foreground" Value="{StaticResource BlueXl}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProfileStatus}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Border Height="24" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Systemdaten -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.System}" Style="{StaticResource H2}" Margin="0,0,0,18" />
                    <TextBlock Text="{DynamicResource Dashboard.Loading}" Style="{StaticResource MutedText}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource Dashboard.Os}" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperatingSystem}" Style="{StaticResource RowValue}" />

                        <TextBlock Grid.Row="1" Text="{DynamicResource Dashboard.Cpu}" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Processor}" Style="{StaticResource RowValue}" />

                        <TextBlock Grid.Row="2" Text="{DynamicResource Dashboard.Gpu}" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Graphics}" Style="{StaticResource RowValue}" />

                        <TextBlock Grid.Row="3" Text="{DynamicResource Dashboard.Ram}" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Memory}" Style="{StaticResource RowValue}" />

                        <TextBlock Grid.Row="4" Text="{DynamicResource Dashboard.Rights}" Style="{StaticResource RowLabel}" Margin="0,0,24,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                    <Setter Property="Text" Value="{DynamicResource Dashboard.NoAdmin}" />
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Dashboard.Admin}" />
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status: wird ab Phase 2 und 3 mit echten Werten gefüllt -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.Status}" Style="{StaticResource H2}" Margin="0,0,0,18" />
                    <TextBlock Text="{DynamicResource Dashboard.ActiveTweaks}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding ActiveTweaks}" Style="{StaticResource Display}" FontSize="34" Foreground="{StaticResource BlueL}" Margin="0,2,0,18" />
                    <TextBlock Text="{DynamicResource Dashboard.LastRestore}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                    <TextBlock Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                <Setter Property="Text" Value="{Binding LastRestorePoint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRestorePoint}" Value="False">
                                        <Setter Property="Text" Value="{DynamicResource Dashboard.NotYet}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
