<UserControl x:Class="MunzQuickTweaks.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MunzQuickTweaks.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="SysRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,10" />
        </Style>

        <!-- Profilkarte: Pixel-Icon, Name, Zweck, Anzahl -->
        <Style x:Key="ProfileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Command" Value="{Binding ApplyProfileCommand}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Blue}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueXl}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProfileIcon" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource BlueSoft}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,-12,0,24">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" />
            <TextBlock Text="{DynamicResource Dashboard.Intro}" Style="{StaticResource Body2}" MaxWidth="640" HorizontalAlignment="Left" />
        </DockPanel>

        <!-- Hinweis bei nicht unterstützter Windows-Version -->
        <Border Background="#1AFFB547" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10"
                Padding="16,12" Margin="0,0,0,20"
                Visibility="{Binding IsUnsupported, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{DynamicResource Dashboard.Unsupported}" Style="{StaticResource TextBase}" Foreground="{StaticResource Warn}" />
        </Border>

        <!-- Kacheln -->
        <UniformGrid Columns="3" Margin="0,0,0,26">
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.ActiveTweaksLabel}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding ActiveTweaks}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="{Binding AvailableText}" Style="{StaticResource Body2}" FontSize="13" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.RestoreLabel}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                    <TextBlock Foreground="{StaticResource Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                <Setter Property="Text" Value="{Binding LastRestorePoint}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRestorePoint}" Value="False">
                                        <Setter Property="Text" Value="{DynamicResource Dashboard.NotYet}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding RestoreSub}" Style="{StaticResource Body2}" FontSize="13" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.ProtectionLabel}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding ProtectionText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProtectionOn}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource Dashboard.ProtectionSub}" Style="{StaticResource Body2}" FontSize="13" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Profile -->
        <TextBlock Text="{DynamicResource Profile.Title}" Style="{StaticResource Label}" Margin="2,0,0,12" />
        <UniformGrid Columns="4" Margin="0,0,0,8">
            <Button Style="{StaticResource ProfileButton}" CommandParameter="Recommended">
                <StackPanel>
                    <Border Style="{StaticResource ProfileIcon}"><c:PixelIcon Pattern="00100/01110/11111/01110/01010" Width="16" Height="16" Foreground="{StaticResource BlueL}" /></Border>
                    <TextBlock Text="{DynamicResource Profile.Recommended}" Style="{StaticResource TextBase}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{DynamicResource Profile.Recommended.Hint}" Style="{StaticResource MutedText}" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding RecommendedInfo}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ProfileButton}" CommandParameter="Gaming">
                <StackPanel>
                    <Border Style="{StaticResource ProfileIcon}"><c:PixelIcon Pattern="01110/11111/10101/11111/01010" Width="16" Height="16" Foreground="{StaticResource BlueL}" /></Border>
                    <TextBlock Text="{DynamicResource Profile.Gaming}" Style="{StaticResource TextBase}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{DynamicResource Profile.Gaming.Hint}" Style="{StaticResource MutedText}" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding GamingInfo}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ProfileButton}" CommandParameter="Privacy">
                <StackPanel>
                    <Border Style="{StaticResource ProfileIcon}"><c:PixelIcon Pattern="01110/10001/11111/11011/11111" Width="16" Height="16" Foreground="{StaticResource BlueL}" /></Border>
                    <TextBlock Text="{DynamicResource Profile.Privacy}" Style="{StaticResource TextBase}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{DynamicResource Profile.Privacy.Hint}" Style="{StaticResource MutedText}" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding PrivacyInfo}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ProfileButton}" CommandParameter="ResetAll" Margin="0">
                <StackPanel>
                    <Border Style="{StaticResource ProfileIcon}"><c:PixelIcon Pattern="01110/10101/10111/10001/01110" Width="16" Height="16" Foreground="{StaticResource BlueL}" /></Border>
                    <TextBlock Text="{DynamicResource Profile.ResetAll}" Style="{StaticResource TextBase}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{DynamicResource Profile.ResetAll.Hint}" Style="{StaticResource MutedText}" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding ResetInfo}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Button>
        </UniformGrid>
        <TextBlock Text="{Binding ProfileStatus}" Margin="2,6,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                    <Setter Property="Foreground" Value="{StaticResource BlueXl}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProfileStatus}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Border Height="22" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Dein System -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.System}" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Dashboard.Loading}" Style="{StaticResource MutedText}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource SysRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Dashboard.Os}" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding OperatingSystem}" Style="{StaticResource TextBase}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SysRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Dashboard.Cpu}" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Processor}" Style="{StaticResource TextBase}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SysRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Dashboard.Gpu}" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Graphics}" Style="{StaticResource TextBase}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SysRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Dashboard.Ram}" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Memory}" Style="{StaticResource TextBase}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SysRow}" Padding="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Dashboard.Rights}" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                            <Setter Property="Text" Value="{DynamicResource Dashboard.NoAdmin}" />
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Dashboard.Admin}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Zuletzt geändert -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dashboard.Recent}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Cursor="Hand" Command="{Binding OpenHistoryCommand}" Margin="0,12,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="Link" Text="{DynamicResource Dashboard.FullHistory}" FontFamily="{StaticResource FontSans}" FontSize="13" Foreground="{StaticResource BlueXl}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Link" Property="TextDecorations" Value="Underline" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.NoRecent}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecent}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
