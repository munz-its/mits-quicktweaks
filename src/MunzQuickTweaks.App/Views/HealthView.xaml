<UserControl x:Class="MunzQuickTweaks.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate x:Key="HealthRowTemplate">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="4" Padding="9,3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Bg3}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGood}" Value="True">
                                        <Setter Property="Background" Value="#1A3DD68C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Background" Value="#1AFFB547" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBad}" Value="True">
                                        <Setter Property="Background" Value="#1AFF5C5C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding LevelText}" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                    <Setter Property="Foreground" Value="{StaticResource Text2}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGood}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBad}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.Health}" Style="{StaticResource Body2}" Margin="0,0,0,20" />
        <TextBlock Text="{DynamicResource Dashboard.Loading}" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <TextBlock Text="{DynamicResource Health.DisksTitle}" Style="{StaticResource Label}" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding Disks}" Focusable="False" ItemTemplate="{StaticResource HealthRowTemplate}" Margin="0,0,0,10" />

        <StackPanel Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Health.BatteryTitle}" Style="{StaticResource Label}" Margin="0,0,0,10" />
            <ContentControl Content="{Binding Battery}" ContentTemplate="{StaticResource HealthRowTemplate}" Focusable="False" />
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="{DynamicResource Health.Report}" Command="{Binding BatteryReportCommand}" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Health.RepairTitle}" Style="{StaticResource H2}" FontSize="16" />
                <TextBlock Text="{DynamicResource Health.RepairText}" Style="{StaticResource Body2}" Margin="0,6,0,12" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="{DynamicResource Health.Sfc}" Command="{Binding RunSfcCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="{DynamicResource Health.Dism}" Command="{Binding RunDismCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource TextBase}" Foreground="{StaticResource BlueXl}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
