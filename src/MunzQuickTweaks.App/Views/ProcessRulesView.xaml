<UserControl x:Class="MunzQuickTweaks.App.Views.ProcessRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.Processes}" Style="{StaticResource Body2}" Margin="0,0,0,20" />

        <TextBlock Text="{Binding Status}" Margin="0,0,0,16">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Neue Regel -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Process.New}" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBox Width="320" Style="{StaticResource SearchBox}" Text="{Binding ExeName, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource Process.ExeHint}"
                             AutomationProperties.Name="{DynamicResource Process.ExeHint}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Process.Browse}" Command="{Binding BrowseCommand}" />
                </StackPanel>

                <TextBlock Text="{DynamicResource Process.CpuLabel}" Style="{StaticResource Label}" Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,12">
                    <RadioButton Style="{StaticResource Chip}" GroupName="ProcCpu" Content="{DynamicResource Process.Cpu.Idle}" IsChecked="{Binding IsIdle}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="ProcCpu" Content="{DynamicResource Process.Cpu.BelowNormal}" IsChecked="{Binding IsBelowNormal}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="ProcCpu" Content="{DynamicResource Process.Cpu.AboveNormal}" IsChecked="{Binding IsAboveNormal}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="ProcCpu" Content="{DynamicResource Process.Cpu.High}" IsChecked="{Binding IsHigh}" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding LowIo}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Process.IoLabel}" />
                    <TextBlock Text="{DynamicResource Process.IoLabel}" Style="{StaticResource TextBase}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="{DynamicResource Process.Add}" Command="{Binding AddCommand}" />
                <TextBlock Text="{DynamicResource Process.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Vorhandene Regeln -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Process.Existing}" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource Process.None}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRules}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Exe}" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource TextBase}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding IoText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Content="{DynamicResource Process.Remove}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <!-- Grafikkarte pro Programm -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Gpu.Title}" Style="{StaticResource H2}" FontSize="16" />
                <TextBlock Text="{DynamicResource Gpu.Text}" Style="{StaticResource Body2}" Margin="0,6,0,14" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Tweaks.ForeignAccount}" Foreground="{StaticResource Warn}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GpuAllowed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel IsEnabled="{Binding GpuAllowed}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Width="420" Style="{StaticResource SearchBox}" Text="{Binding GpuExe, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource Gpu.ExeHint}"
                                 AutomationProperties.Name="{DynamicResource Gpu.ExeHint}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Process.Browse}" Command="{Binding BrowseGpuCommand}" />
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <RadioButton Style="{StaticResource Chip}" GroupName="GpuChoice" Content="{DynamicResource Gpu.High}" IsChecked="{Binding GpuHigh}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="GpuChoice" Content="{DynamicResource Gpu.Low}" IsChecked="{Binding GpuLow}" />
                    </WrapPanel>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="{DynamicResource Process.Add}" Command="{Binding AddGpuCommand}" />
                    <ItemsControl ItemsSource="{Binding GpuRules}" Focusable="False" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChoiceText}" Style="{StaticResource TextBase}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Content="{DynamicResource Process.Remove}"
                                            Command="{Binding DataContext.RemoveGpuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
