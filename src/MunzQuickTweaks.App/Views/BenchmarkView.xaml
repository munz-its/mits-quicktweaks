<UserControl x:Class="MunzQuickTweaks.App.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.Benchmark}" Style="{StaticResource Body2}" Margin="0,0,0,20" />

        <!-- Auswahl -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel IsEnabled="{Binding IsIdle}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,10">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RunCpu}" AutomationProperties.Name="{DynamicResource Bench.Cpu}" />
                        <TextBlock Text="{DynamicResource Bench.Cpu}" Style="{StaticResource TextBase}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,10">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RunRam}" AutomationProperties.Name="{DynamicResource Bench.RamShort}" />
                        <TextBlock Text="{DynamicResource Bench.RamShort}" Style="{StaticResource TextBase}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,10">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RunDisk}" AutomationProperties.Name="{DynamicResource Bench.DiskShort}" />
                        <TextBlock Text="{DynamicResource Bench.DiskShort}" Style="{StaticResource TextBase}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,10">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RunGpu}" AutomationProperties.Name="{DynamicResource Bench.GpuShort}" />
                        <TextBlock Text="{DynamicResource Bench.GpuShort}" Style="{StaticResource TextBase}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="{DynamicResource Bench.Drive}" Style="{StaticResource Label}" Margin="0,0,0,8" Visibility="{Binding RunDisk, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Drives}" Focusable="False" Margin="0,0,0,10" IsEnabled="{Binding IsIdle}"
                              Visibility="{Binding RunDisk, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchDrive" Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Bench.Start}" Command="{Binding StartCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Bench.Cancel}" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding Progress}" Style="{StaticResource TextBase}" Foreground="{StaticResource Text2}" Margin="0,12,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Bench.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Ergebnis -->
        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Bench.Latest}" Style="{StaticResource Label}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding CompareText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="210" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="12" />
                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource FontMono}" FontSize="20" Foreground="{StaticResource Text}" Margin="0,6,0,4" />
                                <TextBlock Text="{Binding Change}" FontFamily="{StaticResource FontMono}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBetter}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWorse}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Verlauf -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Bench.History}" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource BlueXl}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
