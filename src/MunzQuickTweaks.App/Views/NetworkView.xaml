<UserControl x:Class="MunzQuickTweaks.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.Network}" Style="{StaticResource Body2}" Margin="0,0,0,20" />

        <TextBlock Text="{Binding Status}" Margin="0,0,0,16" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- DNS -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Net.DnsTitle}" Style="{StaticResource H2}" FontSize="16" />
                <TextBlock Text="{DynamicResource Net.DnsText}" Style="{StaticResource Body2}" Margin="0,6,0,12" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource TextBase}" Foreground="{StaticResource Text2}" Margin="0,0,0,4">
                    <Run Text="{DynamicResource Net.Adapter}" /><Run Text=" " /><Run Text="{Binding AdapterText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource TextBase}" Foreground="{StaticResource Text2}" Margin="0,0,0,14">
                    <Run Text="{DynamicResource Net.Current}" /><Run Text=" " /><Run Text="{Binding CurrentDns, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <WrapPanel>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="{DynamicResource Net.Auto}" Command="{Binding SetDnsCommand}" CommandParameter="auto" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="Cloudflare" Command="{Binding SetDnsCommand}" CommandParameter="cloudflare" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="Quad9" Command="{Binding SetDnsCommand}" CommandParameter="quad9" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="Google" Command="{Binding SetDnsCommand}" CommandParameter="google" />
                </WrapPanel>
                <TextBlock Text="{DynamicResource Net.DnsHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Ping -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Net.PingTitle}" Style="{StaticResource H2}" FontSize="16" />
                <TextBlock Text="{DynamicResource Net.PingText}" Style="{StaticResource Body2}" Margin="0,6,0,12" TextWrapping="Wrap" />
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="{DynamicResource Net.PingStart}" Command="{Binding PingCommand}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Pings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextBase}" />
                                <TextBlock Grid.Column="1" Text="{Binding Host}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Result}" FontFamily="{StaticResource FontMono}" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBad}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Werkzeuge -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Net.ToolsTitle}" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,12" />
                <WrapPanel>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="{DynamicResource Net.Flush}" Command="{Binding FlushDnsCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="{DynamicResource Net.Reset}" Command="{Binding ResetNetworkCommand}" />
                </WrapPanel>
                <TextBlock Text="{DynamicResource Net.ResetHint}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
