<UserControl x:Class="MunzQuickTweaks.App.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.GameMode}" Style="{StaticResource Body2}" Margin="0,0,0,20" />

        <Border Style="{StaticResource Card}" Padding="28,24" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Rectangle Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource Line}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <TextBlock VerticalAlignment="Center" FontSize="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource H2}">
                                <Setter Property="Text" Value="{DynamicResource GameMode.StateOff}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource GameMode.StateOn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Since}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="28,12" FontSize="15"
                        Content="{Binding ButtonText}" Command="{Binding ToggleCommand}" />

                <TextBlock Text="{Binding Result}" Margin="0,14,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Result}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{DynamicResource GameMode.WhatTitle}" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,10" />
                <TextBlock Text="{DynamicResource GameMode.What1}" Style="{StaticResource Body2}" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource GameMode.What2}" Style="{StaticResource Body2}" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource GameMode.What3}" Style="{StaticResource Body2}" Margin="0,0,0,10" />
                <TextBlock Text="{DynamicResource GameMode.Note}" Style="{StaticResource MutedText}" FontSize="12" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
