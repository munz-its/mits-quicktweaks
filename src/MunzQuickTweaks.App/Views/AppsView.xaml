<UserControl x:Class="MunzQuickTweaks.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.Apps}" Style="{StaticResource Body2}" Margin="0,0,0,12" />
        <TextBlock Text="{DynamicResource Apps.PolicyHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,20" />

        <Border Background="#1AFFB547" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20"
                Visibility="{Binding IsForeignAccount, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{DynamicResource Tweaks.ForeignAccount}" Style="{StaticResource TextBase}" Foreground="{StaticResource Warn}" />
        </Border>

        <TextBlock Text="{DynamicResource Dashboard.Loading}" Style="{StaticResource MutedText}" Margin="0,0,0,16"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,26">
                        <!-- Kopf: Name, Autostart-Schalter, bei OneDrive Deinstallieren/Installieren -->
                        <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="17" />
                                        <TextBlock Text="{DynamicResource Apps.NotInstalledSelf}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                                                   Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasAutostart, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{DynamicResource Apps.Autostart}" Style="{StaticResource Label}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <CheckBox Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="{Binding AutostartOn}" Command="{Binding ToggleAutostartCommand}"
                                                      AutomationProperties.Name="{DynamicResource Apps.Autostart}" />
                                        </StackPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Margin="16,0,0,0"
                                                Content="{DynamicResource Apps.OneDrive.Uninstall}" Command="{Binding UninstallCommand}"
                                                Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" Margin="16,0,0,0"
                                                Content="{DynamicResource Apps.OneDrive.Install}" Command="{Binding InstallCommand}"
                                                Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Message}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"
                                Visibility="{Binding ShowTweaks, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False" ItemTemplate="{StaticResource TweakItemTemplate}" Margin="0,-1,0,0" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding MissingText}" Style="{StaticResource MutedText}" FontSize="12" Margin="2,0,0,0"
                   Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
