<UserControl x:Class="MunzQuickTweaks.App.Views.InstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.Installer}" Style="{StaticResource Body2}" Margin="0,0,0,20" />

        <Border Background="#1AFFB547" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20"
                Visibility="{Binding WingetMissing, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Install.NoWinget}" Style="{StaticResource TextBase}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="{DynamicResource Install.OpenStore}" Command="{Binding OpenStoreCommand}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Install.Start}" Command="{Binding InstallCommand}" Margin="0,0,10,0" />
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Bench.Cancel}" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Style="{StaticResource TextBase}" Foreground="{StaticResource BlueXl}" Margin="0,0,0,16" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" IsEnabled="{Binding IsIdle}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="250" Margin="0,0,8,10">
                                            <CheckBox Style="{StaticResource PixelCheck}" Content="{Binding Name}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" />
                                            <TextBlock FontSize="11" Margin="28,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                        <Setter Property="Text" Value="{Binding State}" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                                    <Condition Binding="{Binding State}" Value="" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Text" Value="{DynamicResource Install.Installed}" />
                                                                <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
