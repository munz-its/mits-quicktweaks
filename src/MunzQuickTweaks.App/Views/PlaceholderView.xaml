<UserControl x:Class="MunzQuickTweaks.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="28,26" HorizontalAlignment="Left" MaxWidth="640">
        <StackPanel>
            <TextBlock x:Name="Description" Style="{StaticResource Body2}" Margin="0,0,0,18" />
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="8" Height="8" Fill="{StaticResource Blue}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{DynamicResource Placeholder.ComingIn}" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding Phase}" Style="{StaticResource Label}" Margin="5,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
