<UserControl x:Class="MunzQuickTweaks.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MunzQuickTweaks.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Description}" Style="{StaticResource Body2}" MaxWidth="680" HorizontalAlignment="Left" Margin="0,0,0,20" />

        <!-- Fremdes Admin-Konto: Benutzer-Tweaks gesperrt -->
        <Border Background="#1AFFB547" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20"
                Visibility="{Binding IsForeignAccount, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{DynamicResource Tweaks.ForeignAccount}" Style="{StaticResource TextBase}" Foreground="{StaticResource Warn}" />
        </Border>

        <!-- Suche und Filter -->
        <DockPanel Margin="0,0,0,24" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Width="360" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource Tweaks.Search}"
                     AutomationProperties.Name="{DynamicResource Tweaks.Search}" Margin="0,0,14,8" />
            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,0,8">
                <RadioButton Style="{StaticResource Chip}" GroupName="{Binding TitleKey}" Content="{DynamicResource Filter.All}" IsChecked="{Binding IsFilterAll}" />
                <RadioButton Style="{StaticResource Chip}" GroupName="{Binding TitleKey}" Content="{DynamicResource Risk.Low}" IsChecked="{Binding IsFilterLow}" />
                <RadioButton Style="{StaticResource Chip}" GroupName="{Binding TitleKey}" Content="{DynamicResource Risk.Medium}" IsChecked="{Binding IsFilterMedium}" />
                <RadioButton Style="{StaticResource Chip}" GroupName="{Binding TitleKey}" Content="{DynamicResource Filter.Active}" IsChecked="{Binding IsFilterActive}" />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,8" />
        </DockPanel>

        <TextBlock Text="{DynamicResource Tweaks.NoResults}" Style="{StaticResource MutedText}" Margin="0,0,0,20"
                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />

        <!-- Katalog konnte nicht geladen werden -->
        <Border Background="#1AFF5C5C" BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20"
                Visibility="{Binding HasCatalogError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding CatalogError}" Style="{StaticResource TextBase}" Foreground="{StaticResource Danger}" />
        </Border>

        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,28" Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" Margin="2,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="20,16" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,24,0">
                                                <WrapPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontWeight="SemiBold" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="NoWrap" />

                                                    <!-- Risiko-Badge in Pixel-Optik -->
                                                    <Border CornerRadius="4" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1A3DD68C" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMediumRisk}" Value="True">
                                                                        <Setter Property="Background" Value="#1AFFB547" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <Rectangle.Style>
                                                                    <Style TargetType="Rectangle">
                                                                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMediumRisk}" Value="True">
                                                                                <Setter Property="Fill" Value="{StaticResource Warn}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Rectangle.Style>
                                                            </Rectangle>
                                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Text2}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="{Binding RestartText}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                </WrapPanel>

                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Body2}" FontSize="13" />

                                                <!-- Mehr Info: genau welche Einstellung geändert wird -->
                                                <Button HorizontalAlignment="Left" Cursor="Hand" Command="{Binding ToggleDetailsCommand}" Margin="0,6,0,0" Focusable="True">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock x:Name="Link" FontFamily="{StaticResource FontSans}" FontSize="12" Foreground="{StaticResource BlueXl}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{DynamicResource Tweak.MoreInfo}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter Property="Text" Value="{DynamicResource Tweak.LessInfo}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Link" Property="TextDecorations" Value="Underline" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Border Background="{StaticResource Bg3}" CornerRadius="8" Padding="12,10" Margin="0,8,0,0"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Details}" FontFamily="{StaticResource FontMono}" FontSize="11.5"
                                                               Foreground="{StaticResource Text2}" TextWrapping="Wrap" LineHeight="18" />
                                                </Border>

                                                <TextBlock Text="{DynamicResource Tweak.Partial}" Style="{StaticResource TextBase}" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,8,0,0"
                                                           Visibility="{Binding IsPartial, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,8,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Message}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <c:PixelWipe Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                                                         Trigger="{Binding WipeCount}" />

                                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsOn, Mode=OneWay}"
                                                      Command="{Binding ToggleCommand}"
                                                      AutomationProperties.Name="{Binding Title}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
