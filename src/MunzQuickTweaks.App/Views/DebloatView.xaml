<UserControl x:Class="MunzQuickTweaks.App.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Kontrollkästchen im Pixel-Stil -->
    </UserControl.Resources>

    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Desc.Debloat}" Style="{StaticResource Body2}" Margin="0,0,0,20" />

        <Border Background="#1AFFB547" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20"
                Visibility="{Binding IsForeignAccount, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{DynamicResource Debloat.ForeignAccount}" Style="{StaticResource TextBase}" Foreground="{StaticResource Warn}" />
        </Border>

        <TextBlock Text="{DynamicResource Dashboard.Loading}" Style="{StaticResource MutedText}" Margin="0,0,0,16"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Debloat.NoneFound}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasApps}" Value="False" />
                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource Debloat.XboxHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8"
                                           Visibility="{Binding IsXbox, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="250" Margin="0,0,8,10">
                                                <CheckBox Style="{StaticResource PixelCheck}" Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="11" Margin="28,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SizeText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Debloat.Remove}" Command="{Binding RemoveSelectedCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding Status}" Margin="0,14,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                            <Setter Property="Foreground" Value="{StaticResource BlueXl}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Entfernte Apps zum Neuinstallieren -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasRemoved, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Debloat.Removed}" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Debloat.RemovedHint}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding Removed}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TextBase}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                                            Content="{DynamicResource Debloat.Reinstall}"
                                            Command="{Binding DataContext.ReinstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanReinstall, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12"
                                            Content="{DynamicResource Debloat.OpenStore}"
                                            Command="{Binding DataContext.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding StoreUri}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
