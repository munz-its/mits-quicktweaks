<UserControl x:Class="MunzQuickTweaks.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MunzQuickTweaks.App.Controls">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Help.Intro}" Style="{StaticResource Body2}" Margin="0,0,0,20" />

        <TextBlock Text="{Binding Status}" Margin="0,0,0,16">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                    <Setter Property="Foreground" Value="{StaticResource BlueXl}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Support-Anfrage: Beschreibung plus Support-Paket, verschickt über das eigene Mailprogramm -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Help.Request.Title}" Style="{StaticResource H2}" FontSize="16" />
                <TextBlock Text="{DynamicResource Help.Request.Text}" Style="{StaticResource Body2}" Margin="0,6,0,12" TextWrapping="Wrap" />
                <TextBox Style="{StaticResource SearchBox}" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" Text="{Binding Problem, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{DynamicResource Help.Request.Placeholder}" AutomationProperties.Name="{DynamicResource Help.Request.Title}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Help.Request.Send}" Command="{Binding SendRequestCommand}" />
                    <TextBlock Text="{Binding RequestStatus}" Style="{StaticResource TextBase}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="520" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Fernwartung: Kern-Leistung von Munz IT Service -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Background="{StaticResource BlueSoft}" VerticalAlignment="Top" Margin="0,0,18,0">
                    <c:PixelIcon Pattern="11111/10001/11111/00100/01110" Width="18" Height="18" Foreground="{StaticResource BlueL}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Help.Remote}" Style="{StaticResource H2}" FontSize="16" />
                    <TextBlock Text="{DynamicResource Help.RemoteText}" Style="{StaticResource Body2}" Margin="0,6,0,14" />
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Help.RemoteButton}" Command="{Binding OpenRemoteHelpCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Help.MailButton}" Command="{Binding MailSupportCommand}" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Support-Paket -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Background="{StaticResource BlueSoft}" VerticalAlignment="Top" Margin="0,0,18,0">
                    <c:PixelIcon Pattern="11111/11011/10101/10001/11111" Width="18" Height="18" Foreground="{StaticResource BlueL}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Help.Package}" Style="{StaticResource H2}" FontSize="16" />
                    <TextBlock Text="{DynamicResource Help.PackageText}" Style="{StaticResource Body2}" Margin="0,6,0,14" />
                    <WrapPanel>
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Help.PackageButton}" Command="{Binding SaveSupportPackageCommand}" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Kontakt -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Help.Contact}" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="E-MAIL" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                    <TextBlock Grid.Column="1" Text="{Binding MailAddress}" Style="{StaticResource TextBase}" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="1" Text="WEB" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Cursor="Hand" Command="{Binding OpenWebsiteCommand}" Margin="0,0,0,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="munz-its.de" FontFamily="{StaticResource FontSans}" FontSize="14" Foreground="{StaticResource BlueXl}" TextDecorations="Underline" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Grid.Row="2" Text="DISCORD" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Cursor="Hand" Command="{Binding OpenDiscordCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="discord.gg/zmg2eqyM7M" FontFamily="{StaticResource FontSans}" FontSize="14" Foreground="{StaticResource BlueXl}" TextDecorations="Underline" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
        <!-- Datenschutzhinweise: was die App sendet und was lokal bleibt -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Privacy.Title}" Style="{StaticResource H2}" FontSize="16" />
                <TextBlock Text="{DynamicResource Privacy.Summary}" Style="{StaticResource TextBase}" FontWeight="SemiBold" Margin="0,8,0,14" TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource Privacy.NetTitle}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Privacy.Update}" Style="{StaticResource Body2}" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Privacy.Network}" Style="{StaticResource Body2}" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Privacy.Install}" Style="{StaticResource Body2}" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Privacy.Links}" Style="{StaticResource Body2}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource Privacy.SupportTitle}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Privacy.Support}" Style="{StaticResource Body2}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource Privacy.LocalTitle}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Privacy.Local}" Style="{StaticResource Body2}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource Privacy.ControllerTitle}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Privacy.Controller}" Style="{StaticResource Body2}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <WrapPanel>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="{DynamicResource Privacy.OpenPolicy}" Command="{Binding OpenPrivacyPolicyCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Content="{DynamicResource Privacy.OpenFolder}" Command="{Binding OpenDataFolderCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
