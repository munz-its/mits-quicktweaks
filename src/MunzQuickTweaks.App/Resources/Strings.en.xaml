<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- English. Every key must also exist in Strings.de.xaml (checked by a test). -->

    <sys:String x:Key="App.Name">Munz Quick Tweaks</sys:String>
    <sys:String x:Key="App.By">by Munz IT Service</sys:String>

    <sys:String x:Key="Caption.Minimize">Minimize</sys:String>
    <sys:String x:Key="Caption.Maximize">Maximize</sys:String>
    <sys:String x:Key="Caption.Close">Close</sys:String>

    <sys:String x:Key="Nav.Dashboard">Dashboard</sys:String>
    <sys:String x:Key="Nav.Tweaks">Tweaks</sys:String>
    <sys:String x:Key="Nav.Privacy">Privacy</sys:String>
    <sys:String x:Key="Nav.Debloat">Debloat</sys:String>
    <sys:String x:Key="Nav.Startup">Startup</sys:String>
    <sys:String x:Key="Nav.Care">System Care</sys:String>
    <sys:String x:Key="Nav.Restore">Restore</sys:String>
    <sys:String x:Key="Nav.Settings">Settings</sys:String>

    <sys:String x:Key="Desc.Tweaks">Windows settings for performance, gaming, interface and network. Every tweak with an explanation, a risk level and undo.</sys:String>
    <sys:String x:Key="Desc.Privacy">Telemetry, advertising ID, activity history, web search in Start, Copilot and Recall.</sys:String>
    <sys:String x:Key="Desc.Debloat">Remove preinstalled apps with checkboxes. Reinstalling from the Microsoft Store stays possible.</sys:String>
    <sys:String x:Key="Desc.Startup">Enable or disable programs at Windows startup without deleting them.</sys:String>
    <sys:String x:Key="Desc.Care">Clean temporary files and caches, repair Windows with SFC and DISM.</sys:String>
    <sys:String x:Key="Desc.Restore">Restore points, change log and undo for every tweak.</sys:String>

    <sys:String x:Key="Placeholder.ComingIn">Coming in phase</sys:String>

    <sys:String x:Key="Dashboard.Hello">Welcome 👋</sys:String>
    <sys:String x:Key="Dashboard.Intro">Munz Quick Tweaks makes Windows faster and cleaner. Every change is explained and can be undone.</sys:String>
    <sys:String x:Key="Dashboard.System">Your system</sys:String>
    <sys:String x:Key="Dashboard.Os">Windows</sys:String>
    <sys:String x:Key="Dashboard.Cpu">Processor</sys:String>
    <sys:String x:Key="Dashboard.Gpu">Graphics</sys:String>
    <sys:String x:Key="Dashboard.Ram">Memory</sys:String>
    <sys:String x:Key="Dashboard.Rights">Rights</sys:String>
    <sys:String x:Key="Dashboard.Admin">Administrator ✓</sys:String>
    <sys:String x:Key="Dashboard.NoAdmin">No administrator rights</sys:String>
    <sys:String x:Key="Dashboard.Loading">Reading …</sys:String>
    <sys:String x:Key="Dashboard.Unsupported">This Windows version is not officially supported. Supported are Windows 10 22H2 and Windows 11.</sys:String>
    <sys:String x:Key="Dashboard.Status">Status</sys:String>
    <sys:String x:Key="Dashboard.ActiveTweaks">Active tweaks</sys:String>
    <sys:String x:Key="Dashboard.LastRestore">Last restore point</sys:String>
    <sys:String x:Key="Dashboard.NotYet">None yet</sys:String>

    <sys:String x:Key="Settings.Language">Language</sys:String>
    <sys:String x:Key="Settings.LanguageHint">Automatic follows the Windows display language.</sys:String>
    <sys:String x:Key="Settings.Lang.System">Automatic</sys:String>
    <sys:String x:Key="Settings.Lang.German">Deutsch</sys:String>
    <sys:String x:Key="Settings.Lang.English">English</sys:String>
    <sys:String x:Key="Settings.Animations">Animations</sys:String>
    <sys:String x:Key="Settings.AnimationsHint">Logo build-up at start and pixel effects.</sys:String>
    <sys:String x:Key="Settings.About">About</sys:String>
    <sys:String x:Key="Settings.Version">Version</sys:String>
    <sys:String x:Key="Settings.Imprint">Imprint</sys:String>
    <sys:String x:Key="Settings.Privacy">Privacy</sys:String>
    <sys:String x:Key="Settings.PrivacyText">Munz Quick Tweaks collects no data, needs no account and makes no internet connection. Settings and logs stay on your PC.</sys:String>
    <sys:String x:Key="Settings.Licenses">Fonts: Archivo and IBM Plex, SIL Open Font License 1.1.</sys:String>
</ResourceDictionary>
