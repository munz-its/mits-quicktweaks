    <sys:String x:Key="Reset.Setting">Nach Windows-Updates prüfen</sys:String>
    <sys:String x:Key="Reset.SettingHint">Kurz nach dem Anmelden prüft die App, ob ein Windows-Update Tweaks zurückgesetzt hat, und meldet sich nur dann. Es läuft kein Programm im Hintergrund.</sys:String>
    <sys:String x:Key="Reset.Notice.Heading">Windows-Update hat Tweaks zurückgesetzt</sys:String>
