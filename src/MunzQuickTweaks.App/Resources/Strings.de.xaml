    <sys:String x:Key="Settings.Glass">Glaseffekte</sys:String>
    <sys:String x:Key="Settings.GlassHint">Liquid Glass mit Weichzeichnen und Lichtbrechung. Auf schwachen PCs oder in virtuellen Maschinen abschalten, wenn das Scrollen ruckelt. Gilt nach einem Neustart der App.</sys:String>
    <sys:String x:Key="Settings.Design">Design</sys:String>
    <sys:String x:Key="Settings.DesignHint">Munz ist das Design von Munz IT Service. Liquid Glass ist an Apple angelehnt, mit Glaseffekten und der Schrift Inter.</sys:String>
    <sys:String x:Key="Settings.Design.Munz">Munz</sys:String>
    <sys:String x:Key="Settings.Design.Glass">Liquid Glass</sys:String>
    <sys:String x:Key="Settings.DesignRestart">Das neue Design gilt nach einem Neustart der App.</sys:String>
