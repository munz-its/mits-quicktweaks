    <sys:String x:Key="App.Name">Munz Quick Tweaks</sys:String>
    <sys:String x:Key="App.By">von Munz IT Service</sys:String>

    <sys:String x:Key="Caption.Minimize">Minimieren</sys:String>
    <sys:String x:Key="Caption.Maximize">Maximieren</sys:String>
    <sys:String x:Key="Caption.Close">Schließen</sys:String>

