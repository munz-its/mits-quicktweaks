[
  {
    "id": "privacy.telemetry.min",
    "category": "Privacy",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Telemetrie auf Minimum",
      "en": "Telemetry to minimum"
    },
    "description": {
      "de": "Begrenzt die Diagnosedaten, die Windows an Microsoft sendet, auf das Minimum. In Home und Pro entspricht das der Stufe \"Erforderlich\", ganz abschalten lässt Microsoft dort nicht zu.",
      "en": "Limits the diagnostic data Windows sends to Microsoft to the minimum. In Home and Pro this equals the \"Required\" level; Microsoft does not allow turning it off completely there."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
        "name": "AllowTelemetry",
        "kind": "DWord",
        "value": "0"
      }
    ]
  },
  {
    "id": "privacy.adid.off",
    "category": "Privacy",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Werbe-ID ausschalten",
      "en": "Turn off advertising ID"
    },
    "description": {
      "de": "Windows vergibt dir eine Werbe-ID, über die Apps dein Verhalten für personalisierte Werbung verknüpfen. Ausgeschaltet bekommst du weiter Werbung, aber ohne Profil.",
      "en": "Windows assigns you an advertising ID that apps use to link your behavior for personalized ads. Turned off, you still see ads, but without a profile."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
        "name": "Enabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      }
    ]
  },
  {
    "id": "privacy.tailored.off",
    "category": "Privacy",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Maßgeschneiderte Erfahrungen ausschalten",
      "en": "Turn off tailored experiences"
    },
    "description": {
      "de": "Microsoft nutzt deine Diagnosedaten nicht mehr für persönliche Tipps, Werbung und Empfehlungen.",
      "en": "Microsoft no longer uses your diagnostic data for personal tips, ads and recommendations."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Privacy",
        "name": "TailoredExperiencesWithDiagnosticDataEnabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      }
    ]
  },
  {
    "id": "privacy.activity.off",
    "category": "Privacy",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Aktivitätsverlauf ausschalten",
      "en": "Turn off activity history"
    },
    "description": {
      "de": "Windows speichert nicht mehr, welche Apps, Dateien und Webseiten du nutzt, und lädt diesen Verlauf nicht hoch.",
      "en": "Windows no longer stores which apps, files and websites you use and does not upload this history."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\System",
        "name": "EnableActivityFeed",
        "kind": "DWord",
        "value": "0"
      },
      {
        "type": "registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\System",
        "name": "PublishUserActivities",
        "kind": "DWord",
        "value": "0"
      },
      {
        "type": "registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\System",
        "name": "UploadUserActivities",
        "kind": "DWord",
        "value": "0"
      }
    ]
  },
  {
    "id": "privacy.websearch.off",
    "category": "Privacy",
    "risk": "Low",
    "restart": "SignOut",
    "minBuild": 19045,
    "title": {
      "de": "Websuche im Startmenü ausschalten",
      "en": "Turn off web search in Start"
    },
    "description": {
      "de": "Die Windows-Suche zeigt nur noch Apps, Dateien und Einstellungen auf deinem PC. Deine Suchbegriffe gehen nicht mehr an Bing, und die Suche wird schneller.",
      "en": "Windows search only shows apps, files and settings on your PC. Your search terms no longer go to Bing, and search gets faster."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Policies\\Microsoft\\Windows\\Explorer",
        "name": "DisableSearchBoxSuggestions",
        "kind": "DWord",
        "value": "1"
      },
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Search",
        "name": "BingSearchEnabled",
        "kind": "DWord",
        "value": "0"
      }
    ]
  },
  {
    "id": "privacy.cloudsearch.off",
    "category": "Privacy",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Cloud-Inhalte in der Suche ausschalten",
      "en": "Turn off cloud content in search"
    },
    "description": {
      "de": "Die Windows-Suche durchsucht nicht mehr OneDrive, Outlook und andere Inhalte deines Microsoft-Kontos.",
      "en": "Windows search no longer searches OneDrive, Outlook and other content of your Microsoft account."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings",
        "name": "IsMSACloudSearchEnabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      },
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings",
        "name": "IsAADCloudSearchEnabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      }
    ]
  },
  {
    "id": "privacy.tips.off",
    "category": "Privacy",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Tipps und App-Vorschläge ausschalten",
      "en": "Turn off tips and app suggestions"
    },
    "description": {
      "de": "Stoppt Windows-Tipps, Vorschläge im Startmenü und automatisch beworbene Apps. Weniger Ablenkung und keine ungefragten App-Empfehlungen.",
      "en": "Stops Windows tips, Start menu suggestions and promoted apps. Fewer distractions and no unasked app recommendations."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SubscribedContent-338389Enabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      },
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SoftLandingEnabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      },
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SystemPaneSuggestionsEnabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      }
    ]
  },
  {
    "id": "privacy.silentapps.off",
    "category": "Privacy",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Automatische App-Installation stoppen",
      "en": "Stop automatic app installs"
    },
    "description": {
      "de": "Verhindert, dass Windows ungefragt beworbene Apps und Spiele wie Candy Crush installiert.",
      "en": "Prevents Windows from installing promoted apps and games like Candy Crush without asking."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SilentInstalledAppsEnabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      },
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "PreInstalledAppsEnabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      },
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "OemPreInstalledAppsEnabled",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      }
    ]
  },
