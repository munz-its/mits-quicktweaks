  {
    "id": "privacy.location.off",
    "category": "Privacy",
    "risk": "Medium",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Ortung ausschalten",
      "en": "Turn off location"
    },
    "description": {
      "de": "Kein Programm kann mehr deinen Standort abfragen. Dadurch funktionieren auch Karten, lokales Wetter und \"Mein Gerät suchen\" nicht mehr.",
      "en": "No program can query your location anymore. This also stops maps, local weather and \"Find my device\" from working."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\location",
        "name": "Value",
        "kind": "String",
        "value": "Deny",
        "default": "Allow"
      }
    ]
  },
  {
    "id": "privacy.copilot.off",
    "category": "Privacy",
    "risk": "Medium",
    "restart": "SignOut",
    "minBuild": 22631,
    "title": {
      "de": "Copilot ausblenden",
      "en": "Hide Copilot"
    },
    "description": {
      "de": "Entfernt die Copilot-Schaltfläche aus der Taskleiste und sperrt die Copilot-Seitenleiste. Die eigenständige Copilot-App lässt sich ab Version 1.0 im Bereich Debloat entfernen.",
      "en": "Removes the Copilot button from the taskbar and blocks the Copilot sidebar. The standalone Copilot app can be removed in the Debloat section from version 1.0."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Policies\\Microsoft\\Windows\\WindowsCopilot",
        "name": "TurnOffWindowsCopilot",
        "kind": "DWord",
        "value": "1"
      },
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "name": "ShowCopilotButton",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      }
    ]
  },
  {
    "id": "privacy.recall.off",
    "category": "Privacy",
    "risk": "Medium",
    "restart": "Reboot",
    "minBuild": 26100,
    "title": {
      "de": "Recall ausschalten",
      "en": "Turn off Recall"
    },
    "description": {
      "de": "Recall macht auf Copilot+ PCs laufend Bildschirmfotos und durchsucht sie. Der Tweak verhindert die Aufnahmen und sperrt die Funktion.",
      "en": "Recall continuously takes screenshots on Copilot+ PCs and makes them searchable. This tweak prevents the snapshots and blocks the feature."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
        "name": "DisableAIDataAnalysis",
        "kind": "DWord",
        "value": "1"
      },
      {
        "type": "registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
        "name": "AllowRecallEnablement",
        "kind": "DWord",
        "value": "0"
      }
    ]
  }
