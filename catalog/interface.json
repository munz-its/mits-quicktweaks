      "en": "Removes the Task View button from the taskbar. Win + Tab still works."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "name": "ShowTaskViewButton",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      }
    ]
  },
  {
    "id": "ui.widgets.off",
    "category": "Interface",
    "risk": "Low",
    "restart": "SignOut",
    "minBuild": 19045,
    "title": {
      "de": "Widgets und News ausschalten",
      "en": "Turn off widgets and news"
    },
    "description": {
      "de": "Entfernt die Widgets mit Nachrichten und Wetter aus der Taskleiste und beendet ihre Hintergrundprozesse.",
      "en": "Removes the widgets with news and weather from the taskbar and ends their background processes."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Dsh",
        "name": "AllowNewsAndInterests",
        "kind": "DWord",
        "value": "0"
      },
      {
        "type": "registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Feeds",
        "name": "EnableFeeds",
        "kind": "DWord",
        "value": "0"
      }
    ]
  },
  {
    "id": "ui.endtask.on",
    "category": "Interface",
    "risk": "Low",
    "restart": "None",
    "minBuild": 22631,
    "title": {
      "de": "\"Task beenden\" in der Taskleiste",
      "en": "\"End task\" on the taskbar"
    },
    "description": {
      "de": "Ein Rechtsklick auf ein Taskleisten-Symbol bietet \"Task beenden\". Hängende Programme schließt du so ohne Task-Manager.",
      "en": "Right-clicking a taskbar icon offers \"End task\". You close frozen programs without Task Manager."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\TaskbarDeveloperSettings",
        "name": "TaskbarEndTask",
        "kind": "DWord",
        "value": "1",
        "default": "0"
      }
    ]
  },
