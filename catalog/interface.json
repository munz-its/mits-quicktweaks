[
  {
    "id": "ui.fileext.show",
    "category": "Interface",
    "risk": "Low",
    "restart": "Explorer",
    "minBuild": 19045,
    "title": {
      "de": "Dateiendungen anzeigen",
      "en": "Show file extensions"
    },
    "description": {
      "de": "Zeigt Endungen wie .exe oder .pdf im Explorer. Du erkennst sofort, ob eine Datei ein Programm ist, und fällst nicht auf getarnte Dateien wie Rechnung.pdf.exe herein.",
      "en": "Shows extensions like .exe or .pdf in Explorer. You see at once whether a file is a program and are not fooled by disguised files like invoice.pdf.exe."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "name": "HideFileExt",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      }
    ]
  },
  {
    "id": "ui.hiddenfiles.show",
    "category": "Interface",
    "risk": "Low",
    "restart": "Explorer",
    "minBuild": 19045,
    "title": {
      "de": "Versteckte Dateien anzeigen",
      "en": "Show hidden files"
    },
    "description": {
      "de": "Zeigt versteckte Dateien und Ordner wie AppData im Explorer. Praktisch beim Aufräumen und bei der Fehlersuche. Systemdateien bleiben weiterhin geschützt ausgeblendet.",
      "en": "Shows hidden files and folders like AppData in Explorer. Useful for cleaning up and troubleshooting. Protected system files stay hidden."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "name": "Hidden",
        "kind": "DWord",
        "value": "1",
        "default": "2"
      }
    ]
  },
  {
    "id": "ui.explorer.thispc",
    "category": "Interface",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Explorer startet mit \"Dieser PC\"",
      "en": "Explorer opens to \"This PC\""
    },
    "description": {
      "de": "Ein neues Explorer-Fenster zeigt direkt deine Laufwerke statt Schnellzugriff oder Start.",
      "en": "A new Explorer window shows your drives right away instead of Quick access or Home."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "name": "LaunchTo",
        "kind": "DWord",
        "value": "1"
      }
    ]
  },
  {
    "id": "ui.contextmenu.classic",
    "category": "Interface",
    "risk": "Low",
    "restart": "SignOut",
    "minBuild": 22000,
    "title": {
      "de": "Klassisches Kontextmenü",
      "en": "Classic context menu"
    },
    "description": {
      "de": "Ein Rechtsklick zeigt wieder sofort alle Optionen wie in Windows 10, ohne Umweg über \"Weitere Optionen anzeigen\".",
      "en": "Right-click shows all options right away again, like in Windows 10, without going through \"Show more options\"."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32",
        "name": "",
        "kind": "String",
        "value": ""
      }
    ]
  },
  {
    "id": "ui.taskbar.left",
    "category": "Interface",
    "risk": "Low",
    "restart": "None",
    "minBuild": 22000,
    "title": {
      "de": "Taskleiste links ausrichten",
      "en": "Align taskbar left"
    },
    "description": {
      "de": "Startmenü und App-Symbole sitzen wieder links wie bei Windows 10.",
      "en": "Start menu and app icons sit on the left again, like in Windows 10."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "name": "TaskbarAl",
        "kind": "DWord",
        "value": "0",
        "default": "1"
      }
    ]
  },
  {
    "id": "ui.taskbar.searchicon",
    "category": "Interface",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Suche in der Taskleiste nur als Symbol",
      "en": "Search on taskbar as icon only"
    },
    "description": {
      "de": "Das breite Suchfeld in der Taskleiste wird zu einem kleinen Lupen-Symbol. Mehr Platz für deine Apps.",
      "en": "The wide search box on the taskbar becomes a small magnifier icon. More room for your apps."
    },
    "actions": [
      {
        "type": "registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Search",
        "name": "SearchboxTaskbarMode",
        "kind": "DWord",
        "value": "1",
        "default": "2"
      }
    ]
  },
  {
    "id": "ui.taskview.off",
    "category": "Interface",
    "risk": "Low",
    "restart": "None",
    "minBuild": 19045,
    "title": {
      "de": "Taskansicht-Schaltfläche ausblenden",
      "en": "Hide Task View button"
